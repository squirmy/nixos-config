# Ghostty Terminal Configuration
# Mirroring wezterm setup

# Disable automatic updates
auto-update = off

# Theme
theme = Snazzy

# Font Configuration
font-family = JetBrainsMono Nerd Font
font-size = 13
adjust-cell-height = 10%

# Window Configuration
window-decoration = false
window-padding-x = 8
window-padding-y = 8
confirm-close-surface = true

# Scrollback
scrollback-limit = 3000

# Shell Integration
shell-integration = detect

# Cursor
cursor-style = block
cursor-style-blink = false

# Colors - Inactive pane dimming
background-opacity = 1.0
unfocused-split-opacity = 0.7

# Keybindings - CMD mappings to tmux
# Switch to window by number (tmux)
keybind = super+digit1=text:\x02\x31
keybind = super+digit2=text:\x02\x32
keybind = super+digit3=text:\x02\x33
keybind = super+digit4=text:\x02\x34
keybind = super+digit5=text:\x02\x35
keybind = super+digit6=text:\x02\x36
keybind = super+digit7=text:\x02\x37
keybind = super+digit8=text:\x02\x38
keybind = super+digit9=text:\x02\x39
keybind = super+backquote=text:\x02n
keybind = super+shift+c=text:\x02C
keybind = super+d=text:\x02D
keybind = super+l=text:\x02L
keybind = super+k=text:\x02K
keybind = super+n=text:\x02%
keybind = super+shift+n=text:\x02\x22
keybind = super+t=text:\x02c
keybind = super+w=text:\x02x
keybind = super+z=text:\x02z
keybind = super+shift+t=text:\x02B
keybind = super+ctrl+t=text:\x02J

# Save and reload keybindings (vim)
keybind = super+s=text:\x1b:w\r
keybind = super+shift+r=text:\x1b:source %\r

# Tab navigation
keybind = ctrl+tab=text:\x02n
keybind = ctrl+shift+tab=text:\x02n
keybind = super+shift+backquote=text:\x02p

# Copy/Paste
copy-on-select = clipboard
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
